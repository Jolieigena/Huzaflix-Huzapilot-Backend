  "authentication": {
    "apiKeys": {
      "header": "X-API-Key",
      "managementPath": "/auth/api-keys",
      "scopesPath": "/auth/scopes",
      "scopes": [
        "builds:build:create",
        "builds:build:delete",
        "builds:build:read",
        "builds:build:update",
        "builds:deployment:create",
        "builds:deployment:delete",
        "builds:deployment:read",
        "builds:deployment:update",
        "projects:project:create",
        "projects:project:delete",
        "projects:project:read",
        "projects:project:update",
        "projects:template:create",
        "projects:template:delete",
        "projects:template:read",
        "projects:template:update",
        "workspaces:member:create",
        "workspaces:member:delete",
        "workspaces:member:read",
        "workspaces:member:update",
        "workspaces:workspace:create",
        "workspaces:workspace:delete",
        "workspaces:workspace:read",
        "workspaces:workspace:update"
      ],
      "registry": "gateway-sqlite",
      "cacheSeconds": 0
    },
    "identity": {
      "service": "identity",
      "runtime": "python",
      "database": "sqlite",
      "issuer": "huzaflix",
      "audience": "huza-api",
      "cacheSeconds": 0,
      "accessTokenSeconds": 900,
      "sessionSeconds": 604800,
      "managementPaths": [
        "/auth/roles",
        "/auth/accounts"
      ],
      "roleClaim": "role_id",
      "refreshRotation": true
    }
  },
