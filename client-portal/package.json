{
  "name": "huza-client-portal",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "api:generate": "openapi-typescript openapi.json -o src/api/schema.d.ts",
    "api:sync": "node scripts/sync-api.mjs",
    "build": "npm run api:generate && node scripts/component-contract.mjs && tsc --noEmit && vite build",
    "test:browser": "node scripts/browser-test.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.28.1",
    "openapi-fetch": "0.13.4"
  },
  "devDependencies": {
    "typescript": "5.7.2",
    "vite": "6.0.5",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "openapi-typescript": "7.4.4",
    "playwright": "1.49.1"
  }
}
