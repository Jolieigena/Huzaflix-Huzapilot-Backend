    "components": {
      "schemas": {
        "HuzaApiKeyInput": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Exact entries returned by GET /auth/scopes; empty denies all access"
            },
            "expiresAt": {
              "type": "integer",
              "format": "int64",
              "nullable": true,
              "description": "Expiry as Unix seconds; null means no expiry"
            }
          },
          "required": [
            "name",
            "scopes"
          ],
          "additionalProperties": false
        },
        "HuzaApiKey": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Exact entries returned by GET /auth/scopes; empty denies all access"
            },
            "expiresAt": {
              "type": "integer",
              "format": "int64",
              "nullable": true,
              "description": "Expiry as Unix seconds; null means no expiry"
            },
            "id": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer",
              "format": "int64"
            },
            "revoked": {
              "type": "boolean"
            }
          },
          "required": [
            "name",
            "scopes",
            "expiresAt",
            "id",
            "createdAt",
            "revoked"
          ],
          "additionalProperties": false
        },
        "HuzaCreatedApiKey": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Exact entries returned by GET /auth/scopes; empty denies all access"
            },
            "expiresAt": {
              "type": "integer",
              "format": "int64",
              "nullable": true,
              "description": "Expiry as Unix seconds; null means no expiry"
            },
            "id": {
              "type": "string"
            },
            "createdAt": {
              "type": "integer",
              "format": "int64"
            },
            "revoked": {
              "type": "boolean"
            },
            "key": {
              "type": "string",
              "description": "Secret returned once on creation. Store securely."
            }
          },
          "required": [
            "name",
            "scopes",
            "expiresAt",
            "id",
            "createdAt",
            "revoked",
            "key"
          ],
          "additionalProperties": false
        },
        "HuzaRoleInput": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          },
          "required": [
            "name",
            "scopes"
          ],
          "additionalProperties": false
        },
        "HuzaRole": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "scopes": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "id": {
              "type": "string"
            },
            "system": {
              "type": "boolean"
            }
