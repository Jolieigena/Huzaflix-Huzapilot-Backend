# Settings for the Huzaflix backend. Copy to .env (or run ./create-env.sh, which also fills in the secrets).
# Never commit .env: it holds passwords and keys.

# Secrets. Use long random values, for example: openssl rand -hex 32
JWT_SECRET=
API_KEY_AUTH_SECRET=
DB_PASSWORD=

# The administrator account created the first time the backend starts.
AUTH_USERNAME=admin
AUTH_PASSWORD=
# Optional: the administrator's email address (needed for "Forgot password" by email)
# AUTH_EMAIL=

GATEWAY_PORT=8080
FRONTEND_PORT=5173

# Which addresses may sign in from a browser. Add your deployed frontend address here too.
BROWSER_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
# Set to true when the backend is served over HTTPS
# AUTH_COOKIE_SECURE=true

# Password reset: off, admin (an administrator creates a link) or email (people get it by email)
PASSWORD_RESET=admin
# The page of the frontend that opens from a reset link
PASSWORD_RESET_URL=http://localhost:5174/reset-password

# Email delivery (PASSWORD_RESET=email). Any SMTP server works. For Gmail, use an app password.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_FROM_NAME=Huzaflix
